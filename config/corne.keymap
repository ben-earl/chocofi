#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        system {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    // Outside "&none" placement is because it is a 36 key corne, so the outside PCB was broken off. Need those there to match the shield

    combos {
        compatible = "zmk,combos";

        LBracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <14 15>;
        };

        RBracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <20 21>;
        };

        LBrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <15 16>;
        };

        RBrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <19 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            bindings = <
&none  &kp Q             &kp W           &kp E            &kp R               &kp T              &kp Y        &kp U                &kp I            &kp O            &kp P                         &none
&none  &ht LEFT_SHIFT A  &ht LEFT_ALT S  &ht LEFT_META D  &ht LEFT_CONTROL F  &kp G              &kp H        &ht RIGHT_CONTROL J  &ht RIGHT_GUI K  &ht RIGHT_ALT L  &ht RIGHT_SHIFT SINGLE_QUOTE  &none
&none  &kp Z             &kp X           &kp C            &kp V               &kp B              &kp N        &kp M                &kp COMMA        &kp DOT          &kp SLASH                     &none
                                         &kp LEFT_ALT     &lt 4 ESC           &lt 5 BACKSPACE    &lt 2 SPACE  &lt 1 ENTER          &kp TAB
            >;

            label = "qwerty";
        };

        number {
            bindings = <
&none  &kp LEFT_BRACKET  &kp N7        &kp N8        &kp N9        &kp RIGHT_BRACKET    &none   &none   &none   &none  &none  &none
&none  &kp SEMICOLON     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL            &none   &none   &none   &none  &none  &none
&none  &kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH        &none   &none   &none   &none  &none  &none
                                       &kp PERIOD    &kp N0        &kp MINUS            &trans  &trans  &trans
            >;

            label = "number";
        };

        symbols {
            bindings = <
&none  &kp LEFT_BRACE  &kp LS(AMPS)  &kp LS(STAR)          &kp LS(LPAR)           &kp RIGHT_BRACE    &none  &none  &none  &none  &none  &none
&none  &kp COLON       &kp LS(DLLR)  &kp LS(PRCNT)         &kp LS(CARET)          &kp PLUS           &none  &none  &none  &none  &none  &none
&none  &kp GRAVE       &kp LS(EXCL)  &kp LS(AT)            &kp LS(POUND)          &kp PIPE           &none  &none  &none  &none  &none  &none
                                     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BSPC           &none  &none  &none
            >;

            label = "symbols";
        };

        system {
            bindings = <
&none  &kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0    &bt BT_SEL 2  &out OUT_TOG   &ext_power EP_TOG  &kp C_MUTE    &kp C_NEXT  &none
&none  &kp F5  &kp F6   &kp F7   &kp F8   &bt BT_SEL 1    &bt BT_SEL 3  &kp C_BRI_UP   &none              &kp C_VOL_UP  &kp C_PP    &none
&none  &kp F9  &kp F10  &kp F11  &kp F12  &bt BT_CLR      &bt BT_SEL 4  &kp C_BRI_DEC  &none              &kp C_VOL_DN  &kp C_PREV  &none
                        &trans   &trans   &trans          &trans        &trans         &trans
            >;

            label = "system";
        };

        nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp K_REDO  &kp K_PASTE    &kp K_COPY  &kp K_CUT  &kp K_UNDO    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT    &kp DOWN       &kp UP      &kp RIGHT  &kp CAPSLOCK  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp INSERT  &kp HOME       &kp PG_UP   &kp PG_DN  &kp END       &trans
                        &trans  &trans  &trans    &kp ENTER   &kp BACKSPACE  &kp DELETE
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp K_REDO  &kp K_PASTE  &kp K_COPY  &kp K_CUT  &kp K_UNDO  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans       &trans      &trans     &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans       &trans      &trans     &trans      &trans
                        &trans  &trans  &trans    &mkp RCLK   &mkp LCLK    &mkp MCLK
            >;
        };
    };
};

/ {
    chosen { zmk,battery = &vbatt; };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
        label = "VBATT";
    };
};
